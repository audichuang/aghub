	"knip": {
		"ignoreDependencies": [
			"react-grab",
			"nano-staged",
			"prettier"
		]
	},
	"nano-staged": {
		"*.{js,ts,jsx,tsx,json,md,css,html}": "prettier --write"
	}
}
