{
	"name": "aghub",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "node ./node_modules/@typescript/native/bin/tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"start": "tauri dev",
		"lint": "oxlint --fix",
		"lint:check": "oxlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:dto": "cargo run --manifest-path ../api/Cargo.toml --bin export-dto",
		"test": "node scripts/assert-tests-discovered.mjs && node --experimental-strip-types --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
		"typecheck": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit && node ./node_modules/@typescript/native/bin/tsc -p tsconfig.node.json --noEmit --composite false --incremental false"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"@heroui/react": "^3.2.6",
		"@heroui/styles": "^3.2.6",
		"@lobehub/icons-static-svg": "^1.95.1",
		"@tanstack/react-query": "^5.104.0",
		"@tauri-apps/api": "^2.12.0",
		"@tauri-apps/plugin-autostart": "2.6.0",
		"@tauri-apps/plugin-clipboard-manager": "^2.4.0",
		"@tauri-apps/plugin-deep-link": "^2.5.0",
		"@tauri-apps/plugin-dialog": "^2.8.0",
		"@tauri-apps/plugin-log": "^2.10.0",
		"@tauri-apps/plugin-opener": "^2.6.0",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-store": "^2.5.0",
		"@tauri-apps/plugin-updater": "^2.13.0",
		"bowser": "2.14.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"driver.js": "^1.8.0",
		"fuse.js": "^7.5.0",
		"i18next": "^26.4.2",
		"i18next-browser-languagedetector": "^8.2.1",
		"immer": "^11.1.18",
		"ky": "^2.1.0",
		"nuqs": "^2.10.1",
		"pathe": "^2.0.3",
		"pinyin-pro": "^3.29.4",
		"react": "19.3.0",
		"react-aria-components": "^1.21.1",
		"react-dom": "19.3.0",
		"react-grab": "^0.1.50",
		"react-hook-form": "^7.89.0",
		"react-i18next": "^17.0.15",
		"react-virtuoso": "^4.18.15",
		"rooks": "^9.9.0",
		"simple-icons": "^16.33.0",
		"stable-hash": "^0.0.6",
		"tailwind-merge": "^3.7.0",
		"wouter": "^3.11.0"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.20.8",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.0",
		"@types/node": "^25.9.8",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"knip": "^6.38.0",
		"nano-staged": "^1.0.2",
		"oxlint": "1.85.0",
		"oxlint-tsgolint": "7.0.2003",
		"prettier": "3.8.3",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.1"
	},
	"knip": {
		"ignoreDependencies": [
			"react-grab",
			"nano-staged",
			"prettier"
		]
	},
	"nano-staged": {
		"*.{js,ts,jsx,tsx,json,md,css,html}": "prettier --write"
	}
}
