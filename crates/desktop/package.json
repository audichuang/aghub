{
	"name": "aghub",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "node ./node_modules/@typescript/native/bin/tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"start": "tauri dev",
		"lint": "eslint --fix .",
		"lint:check": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:dto": "cargo run --manifest-path ../api/Cargo.toml --bin export-dto",
		"test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
		"typecheck": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
