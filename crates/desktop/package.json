		"@tanstack/react-query": "^5.102.8",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-autostart": "2.5.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.3",
		"@tauri-apps/plugin-deep-link": "^2.4.10",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"@tauri-apps/plugin-log": "^2.9.1",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-store": "^2.4.4",
		"@tauri-apps/plugin-updater": "^2.11.0",
		"bowser": "2.14.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"driver.js": "^1.8.0",
		"fuse.js": "^7.5.0",
		"i18next": "^26.4.2",
		"i18next-browser-languagedetector": "^8.2.1",
		"immer": "^11.1.18",
		"ky": "^2.1.0",
		"nuqs": "^2.10.1",
		"pathe": "^2.0.3",
		"pinyin-pro": "^3.29.4",
		"react": "19.2.7",
		"react-aria-components": "^1.21.1",
		"react-dom": "19.2.7",
		"react-grab": "^0.1.50",
		"react-hook-form": "^7.88.0",
		"react-i18next": "^17.0.13",
		"react-virtuoso": "^4.18.13",
		"rooks": "^9.9.0",
		"simple-icons": "^16.30.0",
