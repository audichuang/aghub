{
	"name": "aghub",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "node ./node_modules/@typescript/native/bin/tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"start": "tauri dev",
		"lint": "oxlint --fix",
		"lint:check": "oxlint",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"generate:dto": "cargo run --manifest-path ../api/Cargo.toml --bin export-dto",
		"test": "node scripts/assert-tests-discovered.mjs && node --experimental-strip-types --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
		"typecheck": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit && node ./node_modules/@typescript/native/bin/tsc -p tsconfig.node.json --noEmit --composite false --incremental false"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"@heroui/react": "^3.2.7",
		"@heroui/styles": "^3.2.7",
		"@lobehub/icons-static-svg": "^1.102.0",
		"@tanstack/react-query": "^5.107.1",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-autostart": "2.7.0",
		"@tauri-apps/plugin-clipboard-manager": "^2.5.0",
		"@tauri-apps/plugin-deep-link": "^2.6.3",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-log": "^2.10.2",
		"@tauri-apps/plugin-opener": "^2.7.3",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-store": "^2.5.1",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"bowser": "2.15.0",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.10",
		"driver.js": "^1.11.0",
		"fuse.js": "^7.5.0",
		"i18next": "^26.7.2",
		"i18next-browser-languagedetector": "^8.3.0",
		"immer": "^11.2.10",
		"ky": "^2.2.0",
		"nuqs": "^2.10.3",
		"pathe": "^2.0.3",
		"pinyin-pro": "^3.29.5",
		"react": "19.3.1",
		"react-aria-components": "^1.22.1",
		"react-dom": "19.3.1",
		"react-grab": "^0.2.0",
		"react-hook-form": "^7.92.0",
		"react-i18next": "^17.1.13",
		"react-virtuoso": "^4.18.21",
		"rooks": "^9.9.0",
		"simple-icons": "^16.37.0",
		"stable-hash": "^0.0.6",
		"tailwind-merge": "^3.7.0",
		"wouter": "^3.13.0"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.30.2",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.3.0",
		"eslint-plugin-better-tailwindcss": "^4.11.0",
		"knip": "^6.45.1",
		"nano-staged": "^1.0.2",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.8"
	},
	"knip": {
		"ignoreDependencies": [
			"react-grab",
			"nano-staged"
		]
	},
	"nano-staged": {
		"*.{js,ts,jsx,tsx,json,md,css,html}": "oxfmt"
	}
}
