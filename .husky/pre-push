#!/usr/bin/env sh
set -e

# Fallback only (GUI git clients may lack cargo): forcing ~/.cargo/bin first would
# skip a cargo wrapper earlier on PATH (mbx), and plain cargo then fails on its
# read-only restored outputs (docs/history/tooling.md#target-dir-filled-the-disk).
command -v cargo >/dev/null 2>&1 || export PATH="$HOME/.cargo/bin:$PATH"

echo "Running format checks..."
cargo fmt --all -- --check
bun run format:check
node scripts/check-history-links.mjs

echo "Running Rust clippy..."
cargo clippy --workspace --all-targets -- -D warnings

echo "Running desktop lint and typecheck..."
cd crates/desktop
bun run lint:check -- --max-warnings 0
bun run typecheck
